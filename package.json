{
  "name": "ts-rate-limiter",
  "version": "0.1.0",
  "description": "A TypeScript rate-limiting library supporting multiple algorithms and storage backends",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rate-limiter",
    "typescript",
    "redis",
    "token-bucket",
    "sliding-window",
    "fixed-window"
  ],
  "author": "",
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "redis": "^6.3.0"
  }
}